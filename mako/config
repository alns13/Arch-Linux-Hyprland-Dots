# Placement/location
anchor=top-right
layer=overlay
output=
sort=-time

max-visible=5
max-history=20

# Timing (ms) 0 = wait for app or user dismiss.
default-timeout=5000
ignore-timeout=0

# Appearance
font=JetBrainsMono Nerd Font Propo Bold 11
markup=1
actions=1
history=1
text-alignment=left

width=380
height=200
icons=1
max-icon-size=56
icon-location=left
icon-border-radius=12

# surface_container 
background-color=#1E1F25BF
text-color=#E2E2E9FF
border-color=#44464FFF
border-size=1
border-radius=20

progress-color=over #B0C6FFFF

# outer-margin: top clears waybar margin + typical bar height
outer-margin=48,16,16,16
margin=0
padding=14,16

# Interactions
on-button-left=invoke-default-action
on-button-middle=none
on-button-right=dismiss

# low urgency
[urgency=low]
text-color=#C5C6D0FF

# Critical error  
[urgency=critical]
border-color=#FFB4ABFF
border-size=2
progress-color=over #FFB4ABFF

# dnd mode
[mode=do-not-disturb]
invisible=1
